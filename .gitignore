# PyInstaller & build intermediates
*.spec
build/
installers/**/build/
installers/windows_installer/app_bundle.zip

# Build intermediates only. Aster-Browser-Setup.exe itself is committed, so it
# is deliberately absent from this list: rebuild it on Windows with
#   python installers/windows_installer/build_exe.py
# after changing the kit, the logo or the theme, and commit the new one. Each
# rebuild adds its ~20 MB to the repository's history for good, so rebuild it
# for a release rather than for every change.
dist/

# Assistant / agent internal folders (safeguard)
.gemini/
.antigravity/
scratch/
*.tmp
