# install-linux.sh is executed by bash on Linux and is regenerated by
# installers/build_linux_installer.py, which always writes LF. Pin LF here so a
# checkout, edit or commit made on Windows cannot turn it into CRLF, which would
# fail on Linux with "bad interpreter: /bin/bash^M".
*.sh text eol=lf

# Kits, bundles and icons are binary: never line-ending-convert or merge them.
*.zip binary
*.exe binary
*.ico binary
*.png binary
