{
  "manifest_version": 2,
  "name": "Aster Companion",
  "version": "0.2.0",
  "description": "Aster workspaces, persistent parked tabs, reading tools and optional blocking for Firefox.",
  "browser_specific_settings": {
    "gecko": {"id": "aster-companion@aster-browser.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}},
    "gecko_android": {"strict_min_version": "142.0"}
  },
  "permissions": ["storage", "tabs", "activeTab", "webRequest", "webRequestBlocking", "contextualIdentities"],
  "optional_permissions": ["http://*/*", "https://*/*", "cookies"],
  "background": {"scripts": ["core.js", "background.js"], "persistent": false},
  "browser_action": {"default_title": "Aster Companion", "default_popup": "popup.html", "default_icon": "icon.svg"},
  "icons": {"48": "icon.svg", "96": "icon.svg"},
  "options_ui": {"page": "dashboard.html#settings", "open_in_tab": true},
  "commands": {"open-aster": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Open Aster workspace"}},
  "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
}
